rules_version = '2';

// Bhunte AI — Firestore security rules. Data model: docs/architecture.md.
// Money fields are int paisa and quantities int milli-units; reject anything else.
service cloud.firestore {
  match /databases/{database}/documents {

    // One owner, one shop: the shop id is the owner's uid.
    // Helper accounts will need a members list checked here instead.
    function isOwner(shopId) {
      return request.auth != null && request.auth.uid == shopId;
    }

    function incoming() {
      return request.resource.data;
    }

    match /shops/{shopId} {
      allow read: if isOwner(shopId);
      allow create: if isOwner(shopId) && incoming().ownerUid == request.auth.uid;
      allow update: if isOwner(shopId) && incoming().ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /products/{productId} {
        allow read: if isOwner(shopId);
        allow create, update: if isOwner(shopId)
          && incoming().name_ne is string && incoming().name_ne.size() > 0
          && incoming().pricePaisa is int
          && incoming().costPaisa is int
          && incoming().stockMilli is int
          && (incoming().get('packSizeMilli', null) == null || incoming().packSizeMilli is int);
        allow delete: if false;
      }

      match /customers/{customerId} {
        allow read: if isOwner(shopId);
        allow create, update: if isOwner(shopId) && incoming().balancePaisa is int;
        allow delete: if false;

        // Append-only: mistakes are fixed with a reversing entry, never an edit.
        match /ledger/{entryId} {
          allow read: if isOwner(shopId);
          allow create: if isOwner(shopId)
            && incoming().type in ['credit', 'payment']
            && incoming().amountPaisa is int
            && incoming().amountPaisa > 0;
          allow update, delete: if false;
        }
      }

      // Append-only. Voiding a sale will be allowed as an update of `voidedAt` only.
      match /sales/{saleId} {
        allow read: if isOwner(shopId);
        allow create: if isOwner(shopId)
          && incoming().totalPaisa is int
          && incoming().totalPaisa >= 0
          && incoming().createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      // Older stock records (before deliveries/batches); read-only now.
      match /stockEntries/{entryId} {
        allow read: if isOwner(shopId);
        allow write: if false;
      }

      // One bill / one save. Supplier and bill number are optional.
      match /deliveries/{deliveryId} {
        allow read: if isOwner(shopId);
        allow create: if isOwner(shopId)
          && incoming().source in ['opening', 'manual', 'bill_photo', 'product_photo', 'voice']
          && incoming().totalCostPaisa is int
          && incoming().totalCostPaisa >= 0
          && incoming().createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      // One product in one delivery, with its own cost and sale price. Append-only.
      match /batches/{batchId} {
        allow read: if isOwner(shopId);
        allow create: if isOwner(shopId)
          && incoming().qtyMilli is int
          && incoming().qtyMilli > 0
          && incoming().unitCostPaisa is int
          && incoming().totalCostPaisa is int
          && incoming().totalCostPaisa >= 0
          && incoming().salePricePaisa is int
          && incoming().salePricePaisa > 0
          && incoming().createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      // Price history: initial, stock or manual. Append-only.
      match /priceChanges/{changeId} {
        allow read: if isOwner(shopId);
        allow create: if isOwner(shopId)
          && incoming().reason in ['initial', 'stock', 'manual']
          && incoming().newPricePaisa is int
          && incoming().newPricePaisa > 0
          && incoming().createdBy == request.auth.uid;
        allow update, delete: if false;
      }

      // A product's thumbnail (≈256 px JPEG as base64), one per product.
      // 80,000 base64 characters = 60 KB; the app aims for about 30 KB.
      match /productImages/{productId} {
        allow read, delete: if isOwner(shopId);
        allow create, update: if isOwner(shopId)
          && incoming().jpegBase64 is string
          && incoming().jpegBase64.size() > 0
          && incoming().jpegBase64.size() <= 80000
          && incoming().updatedBy == request.auth.uid;
      }

      // Remembered bill line names → product (docs/stock-from-bill.md BR9).
      match /billAliases/{aliasId} {
        allow read, delete: if isOwner(shopId);
        allow create, update: if isOwner(shopId)
          && incoming().text is string
          && incoming().text.size() > 0
          && incoming().text.size() <= 120
          && incoming().productId is string
          && incoming().updatedBy == request.auth.uid;
      }

      // Daily AI read counts (photo reads, limit 100; bill reads, limit 30). Only the Cloud Function writes.
      match /aiUsage/{day} {
        allow read: if isOwner(shopId);
        allow write: if false;
      }

      // Written only by Cloud Functions (the Admin SDK bypasses these rules).
      match /dailySummaries/{day} {
        allow read: if isOwner(shopId);
        allow write: if false;
      }
    }
  }
}
